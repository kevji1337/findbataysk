# ===== ОБЯЗАТЕЛЬНЫЕ =====

# Токен бота от @BotFather
BOT_TOKEN=your_bot_token_from_botfather

# ID канала (начинается с -100)
CHANNEL_ID=-100xxxxxxxxxx

# Админы бота (через запятую для нескольких)
ADMIN_IDS=your_telegram_user_id
# Или для нескольких: ADMIN_IDS=123456789,987654321

# ===== БАЗА ДАННЫХ =====

# URL базы данных
# Укажи адрес внешнего Postgres или сервиса БД из Coolify
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres

# Redis для FSM storage
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# ===== РАССЫЛКА =====

BROADCAST_THROTTLE_SECONDS=0.05
BROADCAST_MAX_RETRIES=3
BROADCAST_WORKER_POLL_SECONDS=1.0
BROADCAST_DRAFT_TTL_SECONDS=600

# Сохранять pending updates при рестарте (рекомендуется false)
DROP_PENDING_UPDATES_ON_STARTUP=false

# Восстановление public.backup при старте контейнера.
# never   - не восстанавливать
# if_empty - восстановить только если schema public пустая
# always  - принудительно восстановить backup
RESTORE_BACKUP_MODE=never
RESTORE_BACKUP_PATH=/app/public.backup
RESTORE_BACKUP_SCHEMA=public
# Для custom-format backup по умолчанию исключаем policy/RLS-объекты,
# которые часто завязаны на внешние роли managed Postgres.
RESTORE_BACKUP_SKIP_OBJECT_TYPES=POLICY,ROW SECURITY,ACL,DEFAULT ACL

# ===== ОПЦИОНАЛЬНО =====

# TTL кеша лидерборда (секунды)
LEADERBOARD_CACHE_TTL_SECONDS=30

# Критерии рекламы (можно переопределить)
# AD_CRITERIA="📋 Минимальные критерии..."
